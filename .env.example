# Base URL of the backend REST API. Locally the Vite proxy serves /v1 from the backend.
# Example remote: http://103.55.104.142:5035/v1
VITE_API_BASE_URL=/v1

# true  = use the in-memory development mock adapter (src/mocks). Nothing is persisted.
# false = call the real API at VITE_API_BASE_URL.
# When unset, mocks are used only if VITE_API_BASE_URL is empty.
VITE_USE_MOCK_API=false
